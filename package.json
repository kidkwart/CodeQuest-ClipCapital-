{
  "name": "clipcapital-monorepo",
  "private": true,
  "description": "ClipCapital monorepo — frontend (Expo app), backend (Node API), more (infra & docs)",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run start",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "typecheck:frontend": "npm --prefix frontend exec tsc -- --noEmit",
    "typecheck:backend": "npm --prefix backend exec tsc -- --noEmit",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend",
    "test:backend": "npm --prefix backend run test"
  }
}
